[Unit]
Description=AIRA signed desktop release publisher (GitHub OIDC)
After=network-online.target
Wants=network-online.target

[Service]
User=aira-release-publish
Group=aira-release-publish
WorkingDirectory=/opt/aira-release-publish
ExecStart=/opt/aira-release-publish/venv/bin/python /opt/aira-release-publish/server.py
Restart=on-failure
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aira-release-publish /srv/aira-public/downloads
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=true
MemoryMax=2G
TasksMax=16

[Install]
WantedBy=multi-user.target
