# Скопировать в .env и заполнить. .env в git не попадает. Ключи — только здесь, не в коде и не в чате.

# --- GigaChat (Сбер), бесплатный тариф Freemium для физлиц ---
# Authorization key из личного кабинета developers.sber.ru → GigaChat API → «Получить ключ».
AIRA_GIGACHAT_AUTH=
# Для физлиц — GIGACHAT_API_PERS.
AIRA_GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GigaChat-2 (Lite) · GigaChat-2-Pro · GigaChat-2-Max
AIRA_GIGACHAT_MODEL=GigaChat-2
# Путь к корневому сертификату НУЦ Минцифры (russian_trusted_root_ca.cer) —
# без него HTTPS к GigaChat не проверяется. Скачать с официальной страницы Госуслуг.
AIRA_GIGACHAT_CA=

# --- Любая OpenAI-совместимая точка (YandexGPT через совместимый API, vLLM и т.п.) ---
AIRA_LLM_BASE_URL=
AIRA_LLM_MODEL=
AIRA_LLM_API_KEY=

# --- Локальная модель ---
AIRA_LOCAL_MODEL=Qwen/Qwen3-4B-Instruct-2507

# --- Тестовый стенд Confluence + Jira (Cloud) — только синтетические и публичные данные ---
# Токен: id.atlassian.com → Безопасность → API-токены. Вставлять только сюда.
AIRA_ATLASSIAN_SITE=https://<имя>.atlassian.net
AIRA_ATLASSIAN_EMAIL=
AIRA_ATLASSIAN_TOKEN=
AIRA_CONFLUENCE_SPACE=
AIRA_JIRA_PROJECT=
