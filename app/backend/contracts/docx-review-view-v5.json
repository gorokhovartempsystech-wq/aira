{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aira:docx-review-view:5",
  "title": "AIRA source-verified ordinary Word review presentation v5",
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "storage_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 19,
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "source_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "document_id",
        "storage_revision",
        "source_sha256"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "attempt_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "execution_kind": {
          "enum": [
            "fixture",
            "local_model"
          ]
        },
        "engine_version": {
          "const": "0.1.0"
        },
        "models_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "adapter_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "attempt_id",
        "execution_kind",
        "engine_version",
        "models_version",
        "model_sha256",
        "adapter_sha256"
      ],
      "additionalProperties": false
    },
    "anchor": {
      "type": "object",
      "properties": {
        "source_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "part_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65535
        },
        "path": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99999
          },
          "maxItems": 128,
          "minItems": 0
        }
      },
      "required": [
        "source_sha256",
        "part_name",
        "path"
      ],
      "additionalProperties": false
    },
    "slice": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "text",
            "tab",
            "break"
          ]
        },
        "anchor": {
          "$ref": "#/$defs/anchor"
        },
        "run_anchor": {
          "$ref": "#/$defs/anchor"
        },
        "paragraph_anchor": {
          "$ref": "#/$defs/anchor"
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      "required": [
        "kind",
        "anchor",
        "run_anchor",
        "paragraph_anchor",
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "fragment_id": {
          "type": "string",
          "minLength": 67,
          "maxLength": 67,
          "pattern": "^vf-[0-9a-f]{64}$"
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000
        },
        "slices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slice"
          },
          "maxItems": 100000,
          "minItems": 1
        }
      },
      "required": [
        "fragment_id",
        "start",
        "end",
        "quote",
        "slices"
      ],
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 67,
          "maxLength": 67,
          "pattern": "^df-[0-9a-f]{64}$"
        },
        "type": {
          "enum": [
            "formulation",
            "duplicate",
            "contradiction"
          ]
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "critical"
          ]
        },
        "assessment": {
          "enum": [
            "red",
            "yellow"
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "primary": {
          "$ref": "#/$defs/evidence"
        },
        "related": {
          "anyOf": [
            {
              "$ref": "#/$defs/evidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "question": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "finding_id",
        "type",
        "severity",
        "assessment",
        "explanation",
        "primary",
        "related",
        "question"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "included",
            "excluded",
            "metadata",
            "empty",
            "blocked"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "part_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65535
        },
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/anchor"
            },
            {
              "type": "null"
            }
          ]
        },
        "fragment_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 67,
              "maxLength": 67,
              "pattern": "^vf-[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "code",
        "part_name",
        "anchor",
        "fragment_id"
      ],
      "additionalProperties": false
    },
    "fragment_id": {
      "type": "string",
      "minLength": 67,
      "maxLength": 67,
      "pattern": "^vf-[0-9a-f]{64}$"
    },
    "list_item": {
      "type": "object",
      "properties": {
        "paragraph_anchor": {
          "$ref": "#/$defs/anchor"
        },
        "properties_anchor": {
          "$ref": "#/$defs/anchor"
        },
        "definition_anchor": {
          "$ref": "#/$defs/anchor"
        },
        "instance_anchor": {
          "$ref": "#/$defs/anchor"
        },
        "start_override_anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/anchor"
            },
            {
              "type": "null"
            }
          ]
        },
        "num_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "format": {
          "enum": [
            "decimal",
            "bullet",
            "upperRoman",
            "lowerRoman"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 31
        },
        "suffix": {
          "enum": [
            "tab",
            "space",
            "nothing"
          ]
        },
        "fragment_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fragment_id"
          },
          "minItems": 0,
          "maxItems": 10000
        },
        "numbering_source": {
          "enum": [
            "direct",
            "style"
          ]
        },
        "style_reference_anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/anchor"
            },
            {
              "type": "null"
            }
          ]
        },
        "style_chain": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/anchor"
          },
          "maxItems": 128,
          "uniqueItems": true
        },
        "level_style_anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/anchor"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "paragraph_anchor",
        "properties_anchor",
        "definition_anchor",
        "instance_anchor",
        "start_override_anchor",
        "num_id",
        "level",
        "ordinal",
        "format",
        "label",
        "suffix",
        "fragment_ids",
        "numbering_source",
        "style_reference_anchor",
        "style_chain",
        "level_style_anchor"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "numbering_source": {
                "const": "direct"
              }
            }
          },
          "then": {
            "properties": {
              "style_reference_anchor": {
                "type": "null"
              },
              "style_chain": {
                "maxItems": 0
              },
              "level_style_anchor": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "style_chain": {
                "minItems": 1
              },
              "level_style_anchor": {
                "$ref": "#/$defs/anchor"
              }
            }
          }
        }
      ]
    },
    "note_reference": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "footnote",
            "endnote"
          ]
        },
        "reference_anchor": {
          "$ref": "#/$defs/anchor"
        },
        "paragraph_anchor": {
          "$ref": "#/$defs/anchor"
        },
        "target_anchor": {
          "$ref": "#/$defs/anchor"
        },
        "before_fragment_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/fragment_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "after_fragment_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/fragment_id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "reference_anchor",
        "paragraph_anchor",
        "target_anchor",
        "before_fragment_id",
        "after_fragment_id"
      ],
      "additionalProperties": false
    },
    "document_context": {
      "type": "object",
      "properties": {
        "lists": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/list_item"
          },
          "minItems": 0,
          "maxItems": 10000
        },
        "note_references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/note_reference"
          },
          "minItems": 0,
          "maxItems": 100000
        }
      },
      "required": [
        "lists",
        "note_references"
      ],
      "additionalProperties": false
    },
    "question": {
      "type": "object",
      "properties": {
        "question_id": {
          "type": "string",
          "minLength": 67,
          "maxLength": 67,
          "pattern": "^dq-[0-9a-f]{64}$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 67,
            "maxLength": 67,
            "pattern": "^df-[0-9a-f]{64}$"
          },
          "maxItems": 10000,
          "minItems": 1
        },
        "visible_finding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 67,
            "maxLength": 67,
            "pattern": "^df-[0-9a-f]{64}$"
          },
          "maxItems": 10000,
          "minItems": 1
        }
      },
      "required": [
        "question_id",
        "text",
        "finding_ids",
        "visible_finding_ids"
      ],
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "properties": {
        "total_findings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "total_questions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "visible_findings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "visible_questions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "hidden_findings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "filtered_findings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "required": [
        "total_findings",
        "total_questions",
        "visible_findings",
        "visible_questions",
        "hidden_findings",
        "filtered_findings"
      ],
      "additionalProperties": false
    },
    "preferences": {
      "type": "object",
      "properties": {
        "disabled_types": {
          "type": "array",
          "items": {
            "enum": [
              "contradiction",
              "duplicate",
              "formulation"
            ]
          },
          "maxItems": 3,
          "uniqueItems": true
        },
        "show_questions": {
          "type": "boolean"
        },
        "show_hidden": {
          "type": "boolean"
        }
      },
      "required": [
        "disabled_types",
        "show_questions",
        "show_hidden"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "source": {
      "$ref": "#/$defs/source"
    },
    "profile": {
      "const": "docx-analysis/final-visible-word-package-v1"
    },
    "policy_version": {
      "const": "docx-analysis-policy/final-visible-no-comments-v2"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "snapshot_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverage"
      },
      "maxItems": 100000,
      "minItems": 0
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      },
      "maxItems": 10000,
      "minItems": 0
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      },
      "maxItems": 10000,
      "minItems": 0
    },
    "no_findings": {
      "type": "boolean"
    },
    "document_context": {
      "$ref": "#/$defs/document_context"
    },
    "schema_version": {
      "const": "docx-review-view/5"
    },
    "stored_result_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "hidden_finding_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 67,
        "maxLength": 67,
        "pattern": "^df-[0-9a-f]{64}$"
      },
      "maxItems": 10000,
      "uniqueItems": true
    },
    "counts": {
      "$ref": "#/$defs/counts"
    },
    "preferences": {
      "$ref": "#/$defs/preferences"
    },
    "no_visible_findings": {
      "type": "boolean"
    },
    "fixture": {
      "type": "boolean"
    }
  },
  "required": [
    "source",
    "profile",
    "policy_version",
    "provenance",
    "snapshot_sha256",
    "coverage",
    "findings",
    "questions",
    "no_findings",
    "document_context",
    "schema_version",
    "stored_result_sha256",
    "hidden_finding_ids",
    "counts",
    "preferences",
    "no_visible_findings",
    "fixture"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "provenance": {
            "properties": {
              "execution_kind": {
                "const": "fixture"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "fixture": {
            "const": true
          },
          "no_findings": {
            "const": false
          }
        }
      },
      "else": {
        "properties": {
          "fixture": {
            "const": false
          }
        }
      }
    }
  ]
}
