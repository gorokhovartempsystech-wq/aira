{
  "$defs": {
    "BaseDocument": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "minLength": 1,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000\\uD800-\\uDFFF]*$",
          "title": "Document Id",
          "type": "string"
        },
        "version_id": {
          "minLength": 1,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000\\uD800-\\uDFFF]*$",
          "title": "Version Id",
          "type": "string"
        },
        "blocks": {
          "items": {
            "$ref": "#/$defs/Block"
          },
          "title": "Blocks",
          "type": "array"
        }
      },
      "required": [
        "document_id",
        "version_id",
        "blocks"
      ],
      "title": "BaseDocument",
      "type": "object"
    },
    "Block": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000\\uD800-\\uDFFF]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "heading",
            "paragraph",
            "list",
            "table",
            "code",
            "unsupported"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "pattern": "^[^\\u0000\\uD800-\\uDFFF]*$",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "text"
      ],
      "title": "Block",
      "type": "object"
    },
    "Context": {
      "additionalProperties": false,
      "properties": {
        "revision_id": {
          "minLength": 1,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000\\uD800-\\uDFFF]*$",
          "title": "Revision Id",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/ContextItem"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "revision_id",
        "items"
      ],
      "title": "Context",
      "type": "object"
    },
    "ContextItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000\\uD800-\\uDFFF]*$",
          "title": "Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "new_requirement",
            "user_clarification",
            "reference"
          ],
          "title": "Role",
          "type": "string"
        },
        "text": {
          "pattern": "^[^\\u0000\\uD800-\\uDFFF]*$",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "role",
        "text"
      ],
      "title": "ContextItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "0.1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000\\uD800-\\uDFFF]*$",
      "title": "Run Id",
      "type": "string"
    },
    "mode": {
      "enum": [
        "lint",
        "merge"
      ],
      "title": "Mode",
      "type": "string"
    },
    "base_document": {
      "$ref": "#/$defs/BaseDocument"
    },
    "context": {
      "$ref": "#/$defs/Context"
    }
  },
  "required": [
    "contract_version",
    "run_id",
    "mode",
    "base_document",
    "context"
  ],
  "title": "AnalysisRequest",
  "type": "object"
}
